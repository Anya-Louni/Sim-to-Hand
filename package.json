{
  "name": "sim-to-hand",
  "version": "0.1.0",
  "description": "LLM-planned robot manipulation in a browser physics sim, with verification and replanning.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "model": "node scripts/build-model.mjs",
    "test:sim": "node --experimental-strip-types --no-warnings scripts/sim-test.ts",
    "bench": "node --experimental-strip-types --no-warnings scripts/bench.ts"
  },
  "dependencies": {
    "@mujoco/mujoco": "^3.17.0",
    "ajv": "^8.20.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
