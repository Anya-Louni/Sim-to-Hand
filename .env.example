# Google AI Studio key (free tier, needed for vision checks): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key (free tier, text-only planning fallback): https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
# Proxy limits (per server instance)
RATE_PER_10MIN=30
RATE_PER_DAY=400
